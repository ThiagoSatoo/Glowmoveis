# Copie este arquivo para .env.local e preencha com as credenciais do seu projeto Supabase
# (Supabase → Project Settings → API).

# Pública — pode ficar exposta no navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# SECRETA — nunca prefixar com VITE_ (isso a exporia no navegador) e nunca comitar.
# Usada só em funções de servidor, para criar contas de Gerente/Usuário já ativas.
SUPABASE_SERVICE_ROLE_KEY=
